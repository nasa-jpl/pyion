# The ION release this branch builds against. Read by setup.py, the build and smoke
# scripts, and the wheel workflow. The Dockerfiles repeat ION_TAG and ION_SHA256 as
# build args because Docker cannot read this file; tests/test_release_pipeline.py
# fails when they drift. Steps for moving to a new ION release: docs/release.md.
ION_TAG=ion-open-source-4.2.1-a.1
ION_BUILD_VERSION=4.2.1-a.1
ION_SHA256=4599484bd359c7396387010b7649efd7c396c23614d16305f03b796a55e19bcd
PYION_VERSION=4.2.1a1+ion4.2.1
